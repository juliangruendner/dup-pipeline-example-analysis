{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "name": "diagnosis-code-and-rec-date-only",
  "status": "draft",
  "resource": "Condition",
  "select": [
    {
      "column": [
        {
          "name": "id",
          "path": "id"
        },
        {
          "name": "patient",
          "path": "subject.reference"
        }
      ]
    },
    {
      "column": [
        {
          "name": "Condition_recordedDate",
          "path": "recordedDate",
          "type": "dateTime"
        }
      ]
    },
    {
      "select": [
        {
          "select": [
            {
              "column": [
                {
                  "name": "Condition_code_codingSct_code",
                  "path": "code",
                  "type": "code"
                }
              ]
            },
            {
              "column": [
                {
                  "name": "Condition_code_codingSct_system",
                  "path": "system",
                  "type": "uri"
                }
              ]
            },
            {
              "column": [
                {
                  "name": "Condition_code_codingSct_version",
                  "path": "version",
                  "type": "string"
                }
              ]
            }
          ],
          "forEachOrNull": "coding.where(system = 'http://snomed.info/sct')"
        }
      ],
      "forEachOrNull": "code"
    },
    {
      "select": [
        {
          "column": [
            {
              "name": "Condition_encounter_reference",
              "path": "reference",
              "type": "string"
            }
          ]
        }
      ],
      "forEachOrNull": "encounter"
    }
  ]
}